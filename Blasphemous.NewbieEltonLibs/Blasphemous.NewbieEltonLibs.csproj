<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net35</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>

		<Title>Newbie Elton Libraries</Title>
		<Authors>NewbieElton</Authors>
		<Description>Library of useful APIs for modding the game Blasphemous 1</Description>
		<Version>0.3.0</Version>

		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<RepositoryUrl>https://github.com/EltonZhang777/Blasphemous.NewbieEltonLibs</RepositoryUrl>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="Blasphemous.GameLibs" Version="4.0.67" />
	  <PackageReference Include="Blasphemous.Framework.Levels" Version="0.1.4" />
	  <PackageReference Include="Blasphemous.ModdingAPI" Version="3.0.1" />
	  <PackageReference Include="Blasphemous.CheatConsole" Version="1.1.0" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="ThirdParty\NLayer\**\*.cs" />
		<ProjectReference Include="ThirdParty\NLayer\NLayer.csproj">
			<PrivateAssets>all</PrivateAssets>
			<Private>true</Private>
		</ProjectReference>
		<None Include="$(MSBuildProjectDirectory)\ThirdParty\NLayer\bin\$(Configuration)\net35\NLayer.dll" Pack="true" PackagePath="lib/net35/" Visible="false" />
		<None Include="$(MSBuildProjectDirectory)\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" Visible="false" />
	</ItemGroup>

  <Target Name="Development" AfterTargets="Build">
    <PropertyGroup>
      <PublishFolder>$(MSBuildProjectDirectory)\..\publish\</PublishFolder>
    </PropertyGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PublishFolder)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\ThirdParty\NLayer\bin\$(Configuration)\net35\NLayer.dll" DestinationFolder="$(PublishFolder)" />
  </Target>

</Project>
