<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <Title>Newbie Elton Libraries Test Mod</Title>
    <Product>Newbie Elton Libraries Test Mod</Product>
    <Authors>NewbieElton</Authors>
    <Company>NewbieElton</Company>
    <Description>External consuming mod for real-game verification.</Description>
    <Version>0.3.0</Version>

    <AssemblyName>NewbieEltonLibsTestMod</AssemblyName>
    <RootNamespace>Blasphemous.NewbieEltonLibs.TestMod</RootNamespace>
    <TargetName>NewbieEltonLibsTestMod</TargetName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <PackageRoot>$(MSBuildProjectDirectory)\..\publish\$(TargetName)</PackageRoot>
    <ProductionLibraryPath>$(MSBuildProjectDirectory)\..\Blasphemous.NewbieEltonLibs\bin\Release\net35\Blasphemous.NewbieEltonLibs.dll</ProductionLibraryPath>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NewbieEltonLibsTestModB" />
    <ProjectReference Include="..\Blasphemous.NewbieEltonLibs\Blasphemous.NewbieEltonLibs.csproj">
      <AdditionalProperties>Configuration=Release</AdditionalProperties>
    </ProjectReference>
    <PackageReference Include="Blasphemous.GameLibs" Version="4.0.67" />
    <PackageReference Include="Blasphemous.Framework.UI" Version="0.2.0" />
    <PackageReference Include="Blasphemous.ModdingAPI" Version="3.0.1" />
    <PackageReference Include="Blasphemous.CheatConsole" Version="1.1.0" />
    <PackageReference Include="Blasphemous.Framework.Levels" Version="0.1.4" />
    <AudioTestFiles Include="$(MSBuildProjectDirectory)\resources\audio\**\*.*" />
    <LocalizationFiles Include="$(MSBuildProjectDirectory)\resources\localization\**\*.*" />
  </ItemGroup>

  <Target Name="PackageTestMod" AfterTargets="Build">
    <RemoveDir Directories="$(PackageRoot)" />
    <MakeDir Directories="$(PackageRoot)\plugins" />
    <MakeDir Directories="$(PackageRoot)\localization" />
    <MakeDir Directories="$(PackageRoot)\data\$(Title)\audio" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageRoot)\plugins" />
    <Copy SourceFiles="$(ProductionLibraryPath)" DestinationFolder="$(PackageRoot)\plugins" />
    <Copy SourceFiles="@(LocalizationFiles)" DestinationFolder="$(PackageRoot)\localization" />
    <Copy SourceFiles="@(AudioTestFiles)" DestinationFolder="$(PackageRoot)\data\$(Title)\audio" />
  </Target>

</Project>
